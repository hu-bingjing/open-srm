# Generate private files with: python scripts/init-local.py
# Compose reads non-secret values here; passwords/keys use private/ secret files.
OPEN_SRM_ENV=local
OPEN_SRM_ERP_ADAPTER=mock
OPEN_SRM_ERP_WRITE_ENABLED=false
OPEN_SRM_DB_USER=opensrm
OPEN_SRM_COOKIE_SECURE=false
OPEN_SRM_HTTP_BIND=127.0.0.1
OPEN_SRM_HTTP_PORT=8080
OPEN_SRM_TLS_BIND=0.0.0.0
OPEN_SRM_TLS_PORT=443
# Native Java development additionally needs OPEN_SRM_DB_URL,
# OPEN_SRM_DB_PASSWORD, OPEN_SRM_BOOTSTRAP_TOKEN, OPEN_SRM_IDEMPOTENCY_KEY.
# Do not commit populated configuration or private files.
